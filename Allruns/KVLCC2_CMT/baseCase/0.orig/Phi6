FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Phi6;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Unit double-body potential for manFlowPrescribed.  Absolute potential
// (fluid at rest far away), u = +grad(Phi).  On the hull the normal gradient
// is set by the solver to (x - x_c) n_y - (y - y_c) n_x (yaw), in mesh
// axes, with x_c the rotationCentre of constant/prescribedMotion.

dimensions      [0 2 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // Disturbance of a body moving through still water: zero far away
    "(inlet|outlet|front|back)"
    {
        type            fixedValue;
        value           uniform 0;
    }

    // Rigid wall (double body) on the mean free surface and on the seabed
    "(upper|lower)"
    {
        type            zeroGradient;
    }

    // Gradient overwritten by manFlowPrescribed
    sphere
    {
        type            fixedGradient;
        gradient        uniform 0;
    }
}

