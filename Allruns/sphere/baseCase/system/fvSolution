FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    PhiD
    {
        solver  GAMG;
        smoother DIC;
        tolerance 1e-7;
        relTol  0.0;
        agglomerator	faceAreaPair;
        mergeLevels	1;
        nCellsInCoarsestLevel	100;
        cacheAgglomeration	true;
    }

    PhiS
    {
        $PhiD;
        relTol 0;
        tolerance 1e-11;
    }

    p
    {
        $Phi;
    }
	
	p_gh
    {
        $Phi;
    }
	
}


potentialFlow
{
    nNonOrthogonalCorrectors 3;
}

basisFlow
{
    nNonOrthogonalCorrectors 10;
}

