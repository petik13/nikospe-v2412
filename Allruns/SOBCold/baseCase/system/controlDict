FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     manFlow;

startFrom       startTime;

startTime       0.0;

stopAt          endTime;

endTime	29.11;

deltaT	0.00634;

writeControl    runTime;

writeInterval	10.00;

purgeWrite      1;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

libs
(
    "libsampling.so"
    "libpotForwardSpeedBC.so"
    "liblinBodyMotion.so"
    "libmiddleFieldForm.so"
);

functions
{
    // Free-surface elevation and velocity at a few stations
    surfaceProbes
    {
        type            patchProbes;
        libs            ("libsampling.so");
        patch           upper;
        fields          (U Phi zeta);
        writeControl    timeStep;
        probeLocations  ((30 0 0) (45 0 0) (54.55 0 0) (54 0.55 0));
    }

    // Linear (first-order) loads on the hull, from the unsteady pressure
    hullForces
    {
        type            forces;
        libs            ("libforces.so");
        patches         (sphere);
        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          1000;
        pRef            0;
        CofR	(27.0 0 0);
        writeControl    timeStep;
    }

    // Froude-Krylov part alone: integrating the analytic incident pressure
    // isolates it from the disturbance and validates the hull discretisation.
    hullForcesFK
    {
        type            forces;
        libs            ("libforces.so");
        patches         (sphere);
        p               dPhiIdt;
        U               UI;
        rho             rhoInf;
        rhoInf          1000;
        pRef            0;
        CofR	(27.0 0 0);
        writeControl    timeStep;
    }

    // Mean wave loads, midfield formulation
    meanLoads
    {
        type            middleFieldForm;
        libs            ("libmiddleFieldForm.so");
        faceZone        controlZone;
        cvPoint	(27.0 0 -0.25);
        freeSurfacePatch upper;
        CofR	(27.0 0 0);
        rhoInf          1000;
        gMag            9.81;
        U               U;
        Us              Us;
        zeta            zeta;
        writeControl    timeStep;
    }
}

