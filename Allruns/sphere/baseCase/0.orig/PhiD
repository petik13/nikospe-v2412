FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      PhiD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // The disturbance vanishes in the far field; the sponge layers absorb
    // what reaches these boundaries.
    "(inlet|outlet|back|front)"
    {
        type            fixedValue;
        value           uniform 0;
    }

    upper
    {
        type            potForwardSpeedBC;
        value           uniform 0;
    }

    lower
    {
        type            zeroGradient;
    }

    sphere
    {
        type            linBodyMotion;
        value           uniform 0;
    }
}

