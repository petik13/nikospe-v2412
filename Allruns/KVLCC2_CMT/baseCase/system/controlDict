FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Circular motion test in waves: prescribed (u, v, r) from
// constant/prescribedMotion, solved in the ship-fixed rotating frame.

application     manFlowPrescribed;

startFrom       startTime;

startTime       0.0;

stopAt          endTime;

endTime	29.11;

deltaT	0.00634;

writeControl    runTime;

writeInterval	10.00;

purgeWrite      1;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

libs
(
    "libsampling.so"
    "libpotRotatingFrameBC.so"
    "liblinBodyMotionRot.so"
    "libmiddleFieldForm.so"
    "libmiddleFieldFormRot.so"
    "libnearFieldForm.so"
);

functions
{
    // Mean wave loads for the ROTATING control volume: middleFieldForm plus
    // the storage and Coriolis terms (derivation in
    // longWavelengthDiscrepancies.ipynb).  The period mean of 'total' is the
    // mean load; 'chen' is identical to meanLoads.  Use these.
    meanLoadsRot
    {
        type            middleFieldFormRot;
        libs            ("libmiddleFieldFormRot.so");
        faceZone        controlZone;
        cvPoint	(27.0 0 -0.25);
        freeSurfacePatch upper;
        hullPatch       sphere;
        CofR	(27.0 0 0);
        rhoInf          1000;
        gMag            9.81;
        writeControl    timeStep;
    }

    // Same on the larger control volume (topoSetDict_2): the corrected load
    // must not depend on the control-volume size
    meanLoadsRot2
    {
        $meanLoadsRot;
        faceZone        controlZone2;
    }

    // Linear (first-order) loads on the hull, from the unsteady pressure
    hullForces
    {
        type            forces;
        libs            ("libforces.so");
        patches         (sphere);
        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          1000;
        pRef            0;
        CofR	(27.0 0 0);
        writeControl    timeStep;
    }

    // Mean wave loads, NEARFIELD (pressure integration over the hull).
    // NOT RELIABLE here: 24% off the midfield for a restrained hull at zero
    // speed, about 2x with motions or forward speed (tests lam3.2_zeroSpeed*,
    // lam3.2_fixed).  Kept only for comparison.
    meanLoadsNear
    {
        type            nearFieldForm;
        libs            ("libnearFieldForm.so");
        patches         (sphere);
        freeSurfacePatch upper;
        CofR	(27.0 0 0);
        rhoInf          1000;
        gMag            9.81;
        writeControl    timeStep;
    }

    // Mean wave loads, midfield formulation (Chen 2022 eq 43), unchanged.
    // Only valid for r = 0: in a turn it misses the storage and Coriolis
    // terms, about 2.2 rho g A^2 B^2/L for the KVLCC2 CMT at lambda/L = 1.
    // Kept for the r = 0 regression against manFlow.
    meanLoads
    {
        type            middleFieldForm;
        libs            ("libmiddleFieldForm.so");
        faceZone        controlZone;
        cvPoint	(27.0 0 -0.25);
        freeSurfacePatch upper;
        CofR	(27.0 0 0);
        rhoInf          1000;
        gMag            9.81;
        U               U;
        Us              Us;
        zeta            zeta;
        writeControl    timeStep;
    }
}

