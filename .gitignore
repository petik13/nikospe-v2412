# ---------------------------------------------------------------------------
# OpenFOAM build artifacts
#
# Everything here is regenerated by wmake / Allwmake. Keeping it out of git
# avoids binary merge conflicts on every branch merge.
# ---------------------------------------------------------------------------

# Compiled binaries and libraries (wmake output tree)
platforms/

# Per-target build directories: Make/linux64GccDPInt32Opt, Make/darwin64Clang..., etc.
# The leading **/ is required: a pattern containing a slash is otherwise
# anchored to this file's directory and would only match at the repo root.
**/Make/linux*/
**/Make/darwin*/
**/Make/windows*/
**/Make/solaris*/

# Auto-generated symlink farms
lnInclude/

# Object files, libraries, dependency files
*.o
*.so
*.so.*
*.a
*.dep

# Build/run logs
log
log.*
*.log

# Editor and OS noise
*~
*.swp
.DS_Store
