FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Circular motion test in waves: prescribed (u, v, r) from
// constant/prescribedMotion, solved in the ship-fixed rotating frame.

application     manFlowPrescribed;

startFrom       startTime;

startTime       0.0;

stopAt          endTime;

endTime	29.11;

deltaT	0.00634;

writeControl    runTime;

writeInterval	10.00;

purgeWrite      1;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

libs
(
    "libsampling.so"
    "libpotRotatingFrameBC.so"
    "liblinBodyMotionRot.so"
    "libmiddleFieldForm.so"
    "libnearFieldForm.so"
);

functions
{
    // Linear (first-order) loads on the hull, from the unsteady pressure
    hullForces
    {
        type            forces;
        libs            ("libforces.so");
        patches         (sphere);
        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          1000;
        pRef            0;
        CofR	(27.0 0 0);
        writeControl    timeStep;
    }

    // Mean wave loads, NEARFIELD (pressure integration over the hull).
    // Instantaneous and frame independent: the one to use while turning.
    meanLoadsNear
    {
        type            nearFieldForm;
        libs            ("libnearFieldForm.so");
        patches         (sphere);
        freeSurfacePatch upper;
        CofR	(27.0 0 0);
        rhoInf          1000;
        gMag            9.81;
        writeControl    timeStep;
    }

    // Mean wave loads, midfield formulation.
    // WARNING: only valid for r = 0.  With yaw rate the control-volume balance
    // misses the storage term d/dt int rho u dV, the Omega x M_V frame term
    // and the rotation part of the strip/flux terms.  Kept for the r = 0
    // regression against manFlow and for comparison with meanLoadsNear.
    meanLoads
    {
        type            middleFieldForm;
        libs            ("libmiddleFieldForm.so");
        faceZone        controlZone;
        cvPoint	(27.0 0 -0.25);
        freeSurfacePatch upper;
        CofR	(27.0 0 0);
        rhoInf          1000;
        gMag            9.81;
        U               U;
        Us              Us;
        zeta            zeta;
        writeControl    timeStep;
    }
}

