FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      bodyMotionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Hold the body at its mean position: the condition then reduces to the pure
// diffraction problem and the m-terms drop out.
fixBody             false;

heading	2.094;
xG	49.0;
zG                  -0.0224;

// Reference dimensions, used to non-dimensionalise the loads
Lpp	3.2;
beam	0.58;

mass                312.622;

I44                 10.56;
I55                 182.85;
I66                 200.08;
I46                 0.0;

C33                 16401.0;   // rho g Awp
C44                 177.88;
C55                 12222.818;
C35                 1806.4;

rollDampingFraction 0.02;       // fraction of critical, roll only

// Soft mooring on the DOF with no hydrostatic restoring (surge, sway, yaw).
// Pick the stiffness so the planar natural period is well above the highest
// wave period -- Seo et al. used "more than five times" -- so the springs hold
// the mean position without touching the wave-frequency response:
//     T_n = 2 pi sqrt( (m + a) / K )   =>   K = (m + a) (2 pi / T_n)^2
// Zero leaves the DOF free.
mooringK11              60;      // surge [N/m]
mooringK22              130;      // sway  [N/m]
mooringK66              100;      // yaw   [N m/rad]

// Damping on the moored DOF as a fraction of critical, to bleed off the slow
// drift oscillation the springs would otherwise sustain.  Formed from the dry
// inertia, so it is a numerical device, not a physical damping model.
mooringDampingFraction  0.1;
rhoInf              1000;

// Artificial added mass for the explicit fluid-structure coupling, per DOF as
// a fraction of the corresponding diagonal inertia:
//     (surge sway heave roll pitch yaw)
// The body condition sets dphi_D/dn = V_b.n, so the pressure -dphi/dt responds
// to the body ACCELERATION and the coupling is an added-mass one, evaluated
// lagged.  It goes unstable once the fluid added mass exceeds the body mass,
// which in heave it does.  Putting A on the left and A*a_old on the right
// suppresses that.  A single scalar applies to all six; 0 is off.
addedMass           (0.1 1 1 1 1 1);

// Drive A from the previous TIME STEP (true) or the previous CORRECTOR
// (false).  The time-step form is what stabilises the coupling, at the price
// of an O(dt) consistency error.  The corrector form is consistent -- A
// cancels once the correctors converge -- but then provides no stabilisation.
addedMassFromTimeStep   true;
steadyRestoring         false;

// Under-relaxation and decay on the new acceleration; 1 is off
accelRelaxation     1.0;
accelDamping        1.0;

newmarkGamma        0.5;
newmarkBeta         0.25;

// ************************************************************************* //
