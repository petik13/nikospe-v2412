            operator==
            (
                Ucur*Foam::cos(b)*Cf.component(vector::X)
              + Ucur*Foam::sin(b)*Cf.component(vector::Y)
            );
        #};
        codeOptions     #{
            -I$(LIB_SRC)/finiteVolume/lnInclude \
            -I$(LIB_SRC)/meshTools/lnInclude
        #};
    }
    upper
    {
        type            zeroGradient;
    }
    lower
    {
        type            zeroGradient;
    }
    sphere
    {
        type            zeroGradient;
    }
    front
    {
        type            codedFixedValue;
        value           uniform 0;
        name            basisPotential;
        codeContext
        {
            Ucur            0.2;
            heading         0;
        }
        codeInclude     #{
            #include "fvCFD.H"
        #};
        code            #{
            const vectorField& Cf = patch().Cf();

